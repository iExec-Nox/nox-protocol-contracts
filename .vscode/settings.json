{
  // Used by Spellchecker extension: streetsidesoftware.code-spell-checker.
  // Spellcheckers are essential to help detect code mistakes but they can
  // be very noisy so here we add words that are not spelling mistakes
  // (names, ...) to reduce noise while keeping the detection effective.
  // Note: keep alphabetical order when updating.
  "cSpell.words": [
    "crytic",
    "IACL",
    "IERC",
    "inheritdoc",
    "Initializable",
    "keccak",
    "nvmrc",
    "sarif",
    "tload",
    "tstore",
    "upgrader",
    "UUPS",
    "viem"
  ]
}
