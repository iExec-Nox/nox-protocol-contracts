{
  "name": "@iexec-nox/nox-protocol-contracts",
  "version": "0.3.0",
  "description": "Nox protocol smart contracts",
  "keywords": [
    "Nox",
    "Confidential DeFi",
    "cDeFi"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "files": [
    "/contracts/**/*.sol",
    "/contracts/**/LICENSE",
    "!/contracts/mock/**",
    "/artifacts/contracts/**/*.json",
    "!/artifacts/contracts/mock/**",
    "/LICENSE-MIT",
    "/DISCLAIMER"
  ],
  "scripts": {
    "prepare": "husky",
    "clean": "pnpm hardhat clean",
    "build": "pnpm hardhat build",
    "test": "pnpm hardhat test",
    "test:gas": "pnpm hardhat test solidity --gas-stats",
    "coverage": "pnpm hardhat test --coverage",
    "deploy": "pnpm hardhat run scripts/deploy.ts",
    "deploy:production": "pnpm hardhat run scripts/deploy.ts --build-profile production",
    "set-gateway": "pnpm hardhat run scripts/set-gateway.ts",
    "set-kms-public-key": "pnpm hardhat run scripts/set-kms-public-key.ts",
    "import-proxy-manifest": "pnpm hardhat run scripts/import-proxy-manifest.ts",
    "upgrade": "bash scripts/upgrade/upgrade.sh",
    "upgrade:production": "bash scripts/upgrade/upgrade.sh --build-profile production",
    "verify": "pnpm hardhat ignition verify",
    "lint": "pnpm eslint --fix . && pnpm solhint 'contracts/**/*.sol' --max-warnings=0",
    "lint:check": "pnpm eslint . && pnpm solhint 'contracts/**/*.sol' --max-warnings=0",
    "format": "pnpm prettier --write .",
    "format:check": "pnpm prettier --check .",
    "update-local-proxy-address": "sh scripts/update-local-proxy-address.sh",
    "diagrams": "sh scripts/generate-diagrams.sh"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{sol,js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "encrypted-types": "^0.0.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.13",
    "@nomicfoundation/hardhat-ignition": "^3.1.7",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@openzeppelin/hardhat-upgrades": "^4.0.1",
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "ethers": "^6.16.0",
    "forge-std": "github:foundry-rs/forge-std#v1.16.1",
    "hardhat": "^3.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "prettier-plugin-solidity": "^2.3.1",
    "solhint": "^6.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "viem": "^2.52.2"
  },
  "homepage": "https://github.com/iExec-Nox/nox-protocol-contracts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iExec-Nox/nox-protocol-contracts.git"
  },
  "bugs": {
    "url": "https://github.com/iExec-Nox/nox-protocol-contracts/issues"
  }
}
