# NOX HANDLE GATEWAY
NOX_HANDLE_GATEWAY_VERSION=dev-7202902e
NOX_HANDLE_GATEWAY_RUST_LOG=info

# NOX KMS
NOX_KMS_VERSION=dev-9b8835d4
NOX_KMS_RUST_LOG=info

# NOX INGESTOR
NOX_INGESTOR_VERSION=dev-ee3c97b7
NOX_INGESTOR_RUST_LOG=info

# NOX RUNNER
NOX_RUNNER_VERSION=dev-22b848fa
NOX_RUNNER_RUST_LOG=info

# Chain config - static, deterministic from CREATE2 deployment on chain 31337
# NOTE: NOX_COMPUTE_CONTRACT is derived from KMS_PUBLIC_KEY (it's part of the proxy init calldata).
# If KMS_PUBLIC_KEY changes, re-run services:up and update NOX_COMPUTE_CONTRACT accordingly.
NOX_CHAIN_ID=31337
NOX_COMPUTE_CONTRACT=0x66197561302495005DB28D8541a32443e395d386
NOX_KMS_SIGNER_ADDRESS=0x2B5AD5c4795c026514f8317c7a215E218DcCD6cF
KMS_PUBLIC_KEY=0x0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798
GATEWAY_ADDRESS=0x7E5F4552091A69125d5DfCb7b8C2659029395Bdf

# RPC URL for docker services (internal docker network, Anvil container)
NOX_RPC_URL=http://anvil:8545

# Starting block for the ingestor (0 is rejected without a persisted state file).
# OffChainServicesMock overrides this at runtime with the current block number.
NOX_INITIAL_BLOCK=1
