# If any file that affects the NoxCompute bytecode changed, redeploy locally and
# patch contracts/sdk/Nox.sol with the new proxy address. The script auto-commits
# the update if Nox.sol was clean before.

# Current branch name
BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Compare against remote branch if it exists, otherwise fall back to main
if git rev-parse --verify origin/$BRANCH > /dev/null 2>&1; then
    CHANGED=$(git diff --name-only origin/$BRANCH HEAD)
else
    CHANGED=$(git diff --name-only origin/main HEAD)
fi

# Filter for files that affect NoxCompute bytecode
BYTECODE_CHANGED=$(echo "$CHANGED" | grep -E \
    'contracts/(interfaces|modules|utils)/|contracts/NoxCompute\.sol')

# Only run the fix script if bytecode-affecting files changed
if [ -n "$BYTECODE_CHANGED" ]; then
    bash scripts/fix-local-address.sh
fi
